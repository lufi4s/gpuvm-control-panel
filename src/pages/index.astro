---
// GPU Cloud Console - customer shell. The interactive app lives in public/app.js
// (ECharts + Motion from public/vendor). Astro outputs this as static HTML.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GPU Cloud Console</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><div><img class="brand-logo" src="/assets/brand/logo-horizontal-brand-reversed.svg" alt="Betopia AI Cloud"><small>Customer control center</small></div></div>
    <div class="side-sec">Compute</div>
    <div class="navwrap">
      <div class="nav-ind" id="navInd"></div>
      <nav id="nav">
        <a data-view="overview" class="active"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>Overview</a>
        <a data-view="instances"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01"/></svg>Instances</a>
        <a data-view="zones"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Zones</a>
        <a data-view="monitoring"><svg viewBox="0 0 24 24"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>Monitoring</a>
        <a data-view="storage"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>Snapshots &amp; Disks</a>
        <a data-view="network"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>Firewall</a>
        <a data-view="keys"><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M16 7l3 3"/></svg>SSH Keys</a>
        <a data-view="billing"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>Billing &amp; Wallet</a>
        <a data-view="activity"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg>Activity</a>
      </nav>
    </div>
    <div class="side-foot">
      <button id="themeBtn" class="btn ghost">Toggle theme</button>
      <button id="resetBtn" class="btn ghost">Reset demo data</button>
      <div class="org"><span class="avatar">AI</span><div><b>Bengal AI Labs</b><span>Dhaka · Pro plan</span></div></div>
    </div>
  </aside>
  <main>
    <header class="top">
      <div><h1 id="title">Overview</h1><p id="subtitle"></p></div>
      <div class="top-actions">
        <span class="chip"><i></i>All zones operational</span>
        <button class="btn primary" id="launchBtn"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Launch GPU VM</button>
      </div>
    </header>
    <section id="view"></section>
  </main>
</div>
<div id="modal" class="modal hidden"></div>
<div id="drawer" class="drawer hidden"></div>
<div id="toasts"></div>
<script is:inline src="/vendor/echarts.min.js"></script>
<script is:inline src="/vendor/bgd.js"></script>
<script is:inline src="/vendor/motion.js"></script>
<script is:inline src="/app.js"></script>
</body>
</html>
